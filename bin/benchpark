import os
import pathlib
import sys
import uuid

# Must run before importing main: main.py bootstraps at import time.
if sys.version_info[:2] < (3, 8):
    sys.exit("ERR: Benchpark requires Python 3.8 or later.")

basedir = pathlib.Path(__file__).resolve().parents[1]
sys.path.insert(0, str(basedir / "lib"))

cov = None
if os.environ.get("BENCHPARK_RUN_COVERAGE"):
    import coverage

    coverage_dir = basedir / f"coverage-data-{os.environ['BENCHPARK_RUN_COVERAGE']}"
    coverage_dir.mkdir(exist_ok=True, parents=True)
    cov = coverage.Coverage(
        data_file=str(coverage_dir / f".coverage.{uuid.uuid4().hex}"),
        source=[str(basedir / "lib")],
    )
    cov.start()

try:
    from main import main  # noqa: E402

    exit_code = main()
finally:
    if cov is not None:
        cov.stop()
        cov.save()

sys.exit(exit_code if isinstance(exit_code, int) else 0)
